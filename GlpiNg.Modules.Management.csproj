<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Modules.Management</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Permet d'utiliser les types ASP.NET Core (composants Razor, AuthenticationStateProvider...)
      dans cette bibliothèque de classes sans dépendre du projet hôte GlpiNg.Web.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Uniquement les abstractions EF Core (DbContext, DbSet<T>) : ce module ne connaît ni le
      fournisseur ni le DbContext concret, qui restent la responsabilité de l'hôte — même montage
      que GlpiNg.Modules.Inventory.csproj.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- ToastService (confirmations/erreurs de formulaire), comme les pages des autres modules. -->
    <PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Abstractions seules : la gestion administrative (tiers, contrats, budgets) ne manipule aucun
      actif de parc ni aucun objet de déploiement. Elle emprunte à l'hôte les documents et les
      notes, par leurs contrats — jamais par leur modèle.
    -->
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
