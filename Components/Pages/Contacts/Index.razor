@page "/management/contacts"
@rendermode InteractiveServer

<PageTitle>@T("Contacts — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>@T("Rechercher")
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" class="form-control" placeholder="@(T("Rechercher un contact..."))"
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">@T("Supprimer {0} contact(s) ? Cette action est définitive.", _selectedIds.Count)</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">@T("Annuler")</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newContactModal">
                <i class="ti ti-plus me-1"></i>@T("Ajouter")
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>@T("Nom")</th>
                    <th>@T("Fonction")</th>
                    <th>@T("Téléphone")</th>
                    <th>@T("Courriel")</th>
                    <th>@T("Fournisseurs")</th>
                    <th>@T("Actif")</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">@T("Aucun contact.")</td></tr>
                }
                else
                {
                    @foreach (Contact contact in _filtered)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(contact.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(contact.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/management/contacts/{contact.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-address-book me-1 text-secondary"></i>@contact.DisplayName
                                </a>
                            </td>
                            <td class="text-secondary">@contact.Type</td>
                            <td class="text-secondary">@(contact.Phone ?? contact.Mobile)</td>
                            <td class="text-secondary">@contact.Email</td>
                            <td class="text-secondary">@contact.Suppliers.Count</td>
                            <td>
                                @if (contact.IsActive)
                                {
                                    <span class="badge bg-success-lt">@T("Oui")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">@T("Non")</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newContactModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-address-book me-2"></i>@T("Nouvel élément - Contact")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>@T("Nom")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                    <input class="form-control" @bind="_newContact.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Prénom")</label>
                    <input class="form-control" @bind="_newContact.FirstName" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Fonction")</label>
                    <input class="form-control" placeholder="@(T("Commercial, support technique…"))" @bind="_newContact.Type" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Téléphone")</label>
                    <input class="form-control" @bind="_newContact.Phone" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Courriel")</label>
                    <input class="form-control" type="email" @bind="_newContact.Email" />
                </div>
                <p class="hint">@T("Le rattachement aux fournisseurs se fait sur la fiche, une fois le contact créé.")</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newContact.Name)"
                        @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>
