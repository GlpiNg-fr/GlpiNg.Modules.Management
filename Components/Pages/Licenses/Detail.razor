@page "/management/licenses/{LicenseId:int}"
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? T("Licence")) — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">@T("Élément introuvable.")</div></div>
}
else
{
    <div class="glping-fiche">
        <div class="glping-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0"><i class="ti ti-license me-2"></i>@_item.Name</h2>
            <div class="btn-list">
                <a class="btn" href="/management/licenses"><i class="ti ti-arrow-left me-1"></i>@T("Retour à la liste")</a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@(T("Supprimer"))">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">@T("Supprimer cet élément ? Cette action est définitive.")</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">@T("Supprimer")</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>@T("Enregistrer")
                </button>
            </div>
        </div>

        <div class="glping-fiche-layout">
            <aside class="glping-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glping-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@T(label)</span>
                        @if (count is { } value)
                        {
                            <span class="glping-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glping-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        @if (ExpirationStatus.IsExpired(_item.ExpirationDate))
                        {
                            <div class="alert alert-danger">Cet élément a expiré le @(Display.LocalDate(_item.ExpirationDate) ?? "—").</div>
                        }
                        else if (ExpirationStatus.IsExpiringSoon(_item.ExpirationDate))
                        {
                            <div class="alert alert-warning">Expire le @(Display.LocalDate(_item.ExpirationDate) ?? "—").</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Nom")<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_item.Name" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Logiciel couvert")</label>
                                    <input class="form-control" @bind="_item.SoftwareName" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Type")</label>
                                    <input class="form-control" @bind="_item.Type" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Numéro de série")</label>
                                    <input class="form-control" @bind="_item.SerialNumber" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Clé d'activation")</label>
                                    <input class="form-control" @bind="_item.LicenseKey" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Postes couverts (0 = illimité)")</label>
                                    <input class="form-control" type="number" @bind="_item.Seats" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Postes déployés")</label>
                                    <input class="form-control" type="number" @bind="_item.UsedSeats" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Date d'achat")</label>
                                    <input class="form-control" type="date" @bind="_item.PurchaseDate" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Date d'expiration")</label>
                                    <input class="form-control" type="date" @bind="_item.ExpirationDate" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Fournisseur")</label>
                                    <select class="form-select" @bind="_supplierId">
                                        <option value="0">—</option>
                                        @foreach (Supplier supplier in _suppliers)
                                        {
                                            <option value="@supplier.Id">@supplier.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Contrat")</label>
                                    <select class="form-select" @bind="_contractId">
                                        <option value="0">—</option>
                                        @foreach (Contract contract in _contracts)
                                        {
                                            <option value="@contract.Id">@contract.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Actif")</label>
                                    <select class="form-select" value="@(_item.IsActive ? "true" : "false")"
                                            @onchange="@(e => _item.IsActive = e.Value?.ToString() == "true")">
                                        <option value="true">@T("Oui")</option>
                                        <option value="false">@T("Non")</option>
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Commentaires")</label>
                                    <textarea class="form-control" rows="3" @bind="_item.Comment"></textarea>
                                </div>
                            </div>
                        </div>
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.SoftwareLicense" ItemId="LicenseId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.SoftwareLicense" ItemId="LicenseId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
