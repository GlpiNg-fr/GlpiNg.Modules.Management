@page "/management/licenses/{LicenseId:int}"
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? "Licence") — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">Élément introuvable.</div></div>
}
else
{
    <div class="glpi-fiche">
        <div class="glpi-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0"><i class="ti ti-license me-2"></i>@_item.Name</h2>
            <div class="btn-list">
                <a class="btn" href="/management/licenses"><i class="ti ti-arrow-left me-1"></i>Retour à la liste</a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="Supprimer">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">Supprimer cet élément ? Cette action est définitive.</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">Annuler</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">Supprimer</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>Enregistrer
                </button>
            </div>
        </div>

        <div class="glpi-fiche-layout">
            <aside class="glpi-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glpi-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@label</span>
                        @if (count is { } value)
                        {
                            <span class="glpi-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glpi-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        @if (ExpirationStatus.IsExpired(_item.ExpirationDate))
                        {
                            <div class="alert alert-danger">Cet élément a expiré le @ExpirationStatus.Label(_item.ExpirationDate).</div>
                        }
                        else if (ExpirationStatus.IsExpiringSoon(_item.ExpirationDate))
                        {
                            <div class="alert alert-warning">Expire le @ExpirationStatus.Label(_item.ExpirationDate).</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Nom<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_item.Name" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Logiciel couvert</label>
                                    <input class="form-control" @bind="_item.SoftwareName" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Type</label>
                                    <input class="form-control" @bind="_item.Type" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Numéro de série</label>
                                    <input class="form-control" @bind="_item.SerialNumber" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Clé d'activation</label>
                                    <input class="form-control" @bind="_item.LicenseKey" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Postes couverts (0 = illimité)</label>
                                    <input class="form-control" type="number" @bind="_item.Seats" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Postes déployés</label>
                                    <input class="form-control" type="number" @bind="_item.UsedSeats" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Date d'achat</label>
                                    <input class="form-control" type="date" @bind="_item.PurchaseDate" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Date d'expiration</label>
                                    <input class="form-control" type="date" @bind="_item.ExpirationDate" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Fournisseur</label>
                                    <select class="form-select" @bind="_supplierId">
                                        <option value="0">—</option>
                                        @foreach (Supplier supplier in _suppliers)
                                        {
                                            <option value="@supplier.Id">@supplier.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Contrat</label>
                                    <select class="form-select" @bind="_contractId">
                                        <option value="0">—</option>
                                        @foreach (Contract contract in _contracts)
                                        {
                                            <option value="@contract.Id">@contract.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Actif</label>
                                    <select class="form-select" value="@(_item.IsActive ? "true" : "false")"
                                            @onchange="@(e => _item.IsActive = e.Value?.ToString() == "true")">
                                        <option value="true">Oui</option>
                                        <option value="false">Non</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Commentaires</label>
                                    <textarea class="form-control" rows="3" @bind="_item.Comment"></textarea>
                                </div>
                            </div>
                        </div>
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.SoftwareLicense" ItemId="LicenseId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.SoftwareLicense" ItemId="LicenseId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
