@page "/management/contracts/{ContractId:int}"
@rendermode InteractiveServer

<PageTitle>@(_contract?.Name ?? "Contrat") — GlpiNg</PageTitle>

@if (_contract is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">Contrat introuvable.</div></div>
}
else
{
    <div class="glpi-fiche">
        <div class="glpi-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0"><i class="ti ti-file-text me-2"></i>@_contract.Name</h2>
            <div class="btn-list">
                <a class="btn" href="/management/contracts"><i class="ti ti-arrow-left me-1"></i>Retour à la liste</a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="Supprimer">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">Supprimer ce contrat et ses coûts ? Cette action est définitive.</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">Annuler</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">Supprimer</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>Enregistrer
                </button>
            </div>
        </div>

        <div class="glpi-fiche-layout">
            <aside class="glpi-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glpi-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@label</span>
                        @if (count is { } value)
                        {
                            <span class="glpi-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glpi-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Nom<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_contract.Name" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Numéro</label>
                                    <input class="form-control" @bind="_contract.Number" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Type</label>
                                    <input class="form-control" @bind="_contract.Type" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Numéro de compte</label>
                                    <input class="form-control" @bind="_contract.AccountNumber" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Actif</label>
                                    <select class="form-select" value="@(_contract.IsActive ? "true" : "false")"
                                            @onchange="@(e => _contract.IsActive = e.Value?.ToString() == "true")">
                                        <option value="true">Oui</option>
                                        <option value="false">Non</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Commentaires</label>
                                    <textarea class="form-control" rows="3" @bind="_contract.Comment"></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Date de début</label>
                                    <input class="form-control" type="date" @bind="_contract.StartDate" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Durée (mois)</label>
                                    <input class="form-control" type="number" min="0" @bind="_contract.DurationMonths" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Préavis (mois)</label>
                                    <input class="form-control" type="number" min="0" @bind="_contract.NoticeMonths" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Périodicité</label>
                                    <select class="form-select" value="@_contract.Periodicity"
                                            @onchange="@(e => _contract.Periodicity = ParsePeriodicity(e.Value))">
                                        @foreach (ContractPeriodicity value in Enum.GetValues<ContractPeriodicity>())
                                        {
                                            <option value="@value">@PeriodicityLabel(value)</option>
                                        }
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Périodicité de facturation</label>
                                    <select class="form-select" value="@_contract.BillingPeriodicity"
                                            @onchange="@(e => _contract.BillingPeriodicity = ParsePeriodicity(e.Value))">
                                        @foreach (ContractPeriodicity value in Enum.GetValues<ContractPeriodicity>())
                                        {
                                            <option value="@value">@PeriodicityLabel(value)</option>
                                        }
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Reconduction</label>
                                    <select class="form-select" value="@_contract.Renewal"
                                            @onchange="@(e => _contract.Renewal = ParseRenewal(e.Value))">
                                        @foreach (ContractRenewal value in Enum.GetValues<ContractRenewal>())
                                        {
                                            <option value="@value">@RenewalLabel(value)</option>
                                        }
                                    </select>
                                </div>

                                <hr />

                                <div class="glpi-fiche-field">
                                    <label>Échéance</label>
                                    <input class="form-control" disabled value="@(_contract.EndDate?.ToString("dd/MM/yyyy") ?? "Sans terme")" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Dénoncer avant le</label>
                                    <input class="form-control @(NoticeIsUrgent ? "text-danger fw-semibold" : "")"
                                           disabled value="@(_contract.NoticeDeadline?.ToString("dd/MM/yyyy") ?? "—")" />
                                    @if (NoticeIsUrgent)
                                    {
                                        <p class="hint text-danger mb-0">
                                            Le préavis court : passé cette date, le contrat se reconduit ou se poursuit.
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                        break;

                    case "fournisseurs":
                        <p class="text-secondary">Tiers engagés par ce contrat.</p>

                        <div class="d-flex gap-2 mb-3" style="max-width: 32rem;">
                            <select class="form-select" @bind="_supplierToAdd">
                                <option value="0">Rattacher un fournisseur…</option>
                                @foreach (Supplier candidate in _supplierCandidates)
                                {
                                    <option value="@candidate.Id">@candidate.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary" disabled="@(_supplierToAdd == 0)"
                                    @onclick="AttachSupplierAsync">
                                <i class="ti ti-plus me-1"></i>Rattacher
                            </button>
                        </div>

                        @if (_suppliers.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-truck"></i>
                                <p class="mb-0">Aucun fournisseur rattaché.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr><th>Nom</th><th>Type</th><th>Téléphone</th><th>Courriel</th><th style="width: 3rem;"></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Supplier supplier in _suppliers)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/management/suppliers/{supplier.Id}")" class="text-reset fw-semibold">
                                                        @supplier.Name
                                                    </a>
                                                </td>
                                                <td class="text-secondary">@supplier.Type</td>
                                                <td class="text-secondary">@supplier.Phone</td>
                                                <td class="text-secondary">@supplier.Email</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Détacher"
                                                            @onclick="() => DetachSupplierAsync(supplier.Id)">
                                                        <i class="ti ti-unlink"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "couts":
                        <p class="text-secondary">
                            Dépenses engagées au titre de ce contrat. Imputer un coût sur un budget est ce qui
                            remplit ce budget.
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">Intitulé</label>
                                        <input class="form-control" @bind="_newCost.Name" @bind:event="oninput" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Début</label>
                                        <input class="form-control" type="date" @bind="_newCost.StartDate" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Fin</label>
                                        <input class="form-control" type="date" @bind="_newCost.EndDate" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Montant</label>
                                        <input class="form-control" type="number" step="0.01" @bind="_newCost.Amount" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Budget</label>
                                        <select class="form-select" @bind="_newCostBudgetId">
                                            <option value="0">—</option>
                                            @foreach (Budget budget in _budgets)
                                            {
                                                <option value="@budget.Id">@budget.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@string.IsNullOrWhiteSpace(_newCost.Name)" @onclick="AddCostAsync">
                                            <i class="ti ti-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (_costs.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-coin"></i>
                                <p class="mb-0">Aucun coût enregistré.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Intitulé</th>
                                            <th>Période</th>
                                            <th>Budget</th>
                                            <th class="text-end">Montant</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ContractCost cost in _costs)
                                        {
                                            <tr>
                                                <td>@cost.Name</td>
                                                <td class="text-secondary">
                                                    @cost.StartDate?.ToString("dd/MM/yyyy") — @cost.EndDate?.ToString("dd/MM/yyyy")
                                                </td>
                                                <td class="text-secondary">
                                                    @if (cost.Budget is { } budget)
                                                    {
                                                        <a href="@($"/management/budgets/{budget.Id}")" class="text-reset">@budget.Name</a>
                                                    }
                                                    else
                                                    {
                                                        <text>—</text>
                                                    }
                                                </td>
                                                <td class="text-end">@Money.Format(cost.Amount)</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Supprimer"
                                                            @onclick="() => DeleteCostAsync(cost.Id)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-end">Total</th>
                                            <th class="text-end">@Money.Format(_costs.Sum(cost => cost.Amount))</th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.Contract" ItemId="ContractId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.Contract" ItemId="ContractId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
