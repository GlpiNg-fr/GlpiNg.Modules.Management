@page "/management/suppliers"
@rendermode InteractiveServer

<PageTitle>Fournisseurs — GlpiNg</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" class="form-control" placeholder="Rechercher un fournisseur..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count fournisseur(s) ? Cette action est définitive.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newSupplierModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    @if (_deleteError is not null)
    {
        <div class="alert alert-danger m-3 mb-0">@_deleteError</div>
    }

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input class="form-check-input m-0" type="checkbox" title="Sélectionner les éléments visibles"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Ville</th>
                    <th>Téléphone</th>
                    <th>Courriel</th>
                    <th>Contacts</th>
                    <th>Contrats</th>
                    <th>Actif</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-secondary py-4">Aucun fournisseur.</td></tr>
                }
                else
                {
                    @foreach (Supplier supplier in _filtered)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(supplier.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(supplier.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/management/suppliers/{supplier.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-truck me-1 text-secondary"></i>@supplier.Name
                                </a>
                            </td>
                            <td class="text-secondary">@supplier.Type</td>
                            <td class="text-secondary">@supplier.Town</td>
                            <td class="text-secondary">@supplier.Phone</td>
                            <td class="text-secondary">@supplier.Email</td>
                            <td class="text-secondary">@supplier.Contacts.Count</td>
                            <td class="text-secondary">@supplier.Contracts.Count</td>
                            <td>
                                @if (supplier.IsActive)
                                {
                                    <span class="badge bg-success-lt">Oui</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">Non</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newSupplierModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-truck me-2"></i>Nouvel élément - Fournisseur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>Nom<span class="text-danger ms-1" title="Champ obligatoire">*</span></label>
                    <input class="form-control" @bind="_newSupplier.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>Type</label>
                    <input class="form-control" placeholder="Revendeur, éditeur, prestataire…" @bind="_newSupplier.Type" />
                </div>
                <div class="glping-fiche-field">
                    <label>Téléphone</label>
                    <input class="form-control" @bind="_newSupplier.Phone" />
                </div>
                <div class="glping-fiche-field">
                    <label>Courriel</label>
                    <input class="form-control" type="email" @bind="_newSupplier.Email" />
                </div>
                <p class="hint">Adresse, contacts et contrats se renseignent sur la fiche, une fois le fournisseur créé.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newSupplier.Name)"
                        @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
