@page "/management/suppliers/{SupplierId:int}"
@rendermode InteractiveServer

<PageTitle>@(_supplier?.Name ?? "Fournisseur") — GlpiNg</PageTitle>

@if (_supplier is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">Fournisseur introuvable.</div></div>
}
else
{
    <div class="glpi-fiche">
        <div class="glpi-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0"><i class="ti ti-truck me-2"></i>@_supplier.Name</h2>
            <div class="btn-list">
                <a class="btn" href="/management/suppliers"><i class="ti ti-arrow-left me-1"></i>Retour à la liste</a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="Supprimer">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">Supprimer ce fournisseur ? Cette action est définitive.</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">Annuler</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">Supprimer</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>Enregistrer
                </button>
            </div>
        </div>

        <div class="glpi-fiche-layout">
            <aside class="glpi-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glpi-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@label</span>
                        @if (count is { } value)
                        {
                            <span class="glpi-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glpi-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Nom<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_supplier.Name" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Type</label>
                                    <input class="form-control" @bind="_supplier.Type" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Numéro d'immatriculation</label>
                                    <input class="form-control" @bind="_supplier.RegistrationNumber" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Adresse</label>
                                    <textarea class="form-control" rows="2" @bind="_supplier.Address"></textarea>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Code postal</label>
                                    <input class="form-control" @bind="_supplier.PostCode" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Ville</label>
                                    <input class="form-control" @bind="_supplier.Town" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Pays</label>
                                    <input class="form-control" @bind="_supplier.Country" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Téléphone</label>
                                    <input class="form-control" @bind="_supplier.Phone" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Fax</label>
                                    <input class="form-control" @bind="_supplier.Fax" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Courriel</label>
                                    <input class="form-control" type="email" @bind="_supplier.Email" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Site web</label>
                                    <input class="form-control" type="url" @bind="_supplier.Website" />
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Actif</label>
                                    <select class="form-select" value="@(_supplier.IsActive ? "true" : "false")"
                                            @onchange="@(e => _supplier.IsActive = e.Value?.ToString() == "true")">
                                        <option value="true">Oui</option>
                                        <option value="false">Non</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Commentaires</label>
                                    <textarea class="form-control" rows="3" @bind="_supplier.Comment"></textarea>
                                </div>
                            </div>
                        </div>
                        break;

                    case "contacts":
                        <p class="text-secondary">Interlocuteurs déclarés chez ce fournisseur.</p>

                        <div class="d-flex gap-2 mb-3" style="max-width: 32rem;">
                            <select class="form-select" @bind="_contactToAdd">
                                <option value="0">Rattacher un contact…</option>
                                @foreach (Contact candidate in _contactCandidates)
                                {
                                    <option value="@candidate.Id">@candidate.DisplayName</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary" disabled="@(_contactToAdd == 0)"
                                    @onclick="AttachContactAsync">
                                <i class="ti ti-plus me-1"></i>Rattacher
                            </button>
                        </div>

                        @if (_contacts.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-address-book"></i>
                                <p class="mb-0">Aucun contact rattaché.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr><th>Nom</th><th>Fonction</th><th>Téléphone</th><th>Courriel</th><th style="width: 3rem;"></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Contact contact in _contacts)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/management/contacts/{contact.Id}")" class="text-reset fw-semibold">
                                                        @contact.DisplayName
                                                    </a>
                                                </td>
                                                <td class="text-secondary">@contact.Type</td>
                                                <td class="text-secondary">@(contact.Phone ?? contact.Mobile)</td>
                                                <td class="text-secondary">@contact.Email</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Détacher"
                                                            @onclick="() => DetachContactAsync(contact.Id)">
                                                        <i class="ti ti-unlink"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "contrats":
                        @if (_contracts.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-file-text"></i>
                                <p class="mb-0">Aucun contrat avec ce fournisseur.</p>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary">
                                Contrats engageant ce fournisseur. Le rattachement se fait depuis la fiche du contrat.
                            </p>
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr><th>Nom</th><th>Numéro</th><th>Type</th><th>Début</th><th>Échéance</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Contract contract in _contracts)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/management/contracts/{contract.Id}")" class="text-reset fw-semibold">
                                                        @contract.Name
                                                    </a>
                                                </td>
                                                <td class="text-secondary">@contract.Number</td>
                                                <td class="text-secondary">@contract.Type</td>
                                                <td class="text-secondary">@contract.StartDate?.ToString("dd/MM/yyyy")</td>
                                                <td class="text-secondary">@contract.EndDate?.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.Supplier" ItemId="SupplierId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.Supplier" ItemId="SupplierId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
