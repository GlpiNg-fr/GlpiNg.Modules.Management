@page "/management/budgets/{BudgetId:int}"
@rendermode InteractiveServer

<PageTitle>@(_budget?.Name ?? T("Budget")) — GlpiNg</PageTitle>

@if (_budget is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">@T("Budget introuvable.")</div></div>
}
else
{
    <div class="glping-fiche">
        <div class="glping-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0"><i class="ti ti-report-money me-2"></i>@_budget.Name</h2>
            <div class="btn-list">
                <a class="btn" href="/management/budgets"><i class="ti ti-arrow-left me-1"></i>@T("Retour à la liste")</a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@(T("Supprimer"))">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;">
                        <p class="mb-2">
                            @T("Supprimer ce budget ? Les {0} coût(s) imputé(s) restent, sans budget. Cette action est définitive.", _costs.Count)
                        </p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">@T("Supprimer")</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>@T("Enregistrer")
                </button>
            </div>
        </div>

        <div class="glping-fiche-layout">
            <aside class="glping-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glping-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@T(label)</span>
                        @if (count is { } value)
                        {
                            <span class="glping-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glping-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Nom")<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_budget.Name" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Code")</label>
                                    <input class="form-control" @bind="_budget.Code" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Type")</label>
                                    <input class="form-control" @bind="_budget.Type" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Montant alloué")</label>
                                    <input class="form-control" type="number" step="0.01" @bind="_budget.Amount" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Début")</label>
                                    <input class="form-control" type="date" @bind="_budget.StartDate" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Fin")</label>
                                    <input class="form-control" type="date" @bind="_budget.EndDate" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Actif")</label>
                                    <select class="form-select" value="@(_budget.IsActive ? "true" : "false")"
                                            @onchange="@(e => _budget.IsActive = e.Value?.ToString() == "true")">
                                        <option value="true">@T("Oui")</option>
                                        <option value="false">@T("Non")</option>
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Commentaires")</label>
                                    <textarea class="form-control" rows="3" @bind="_budget.Comment"></textarea>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-4">
                                <div class="glping-fiche-field">
                                    <label>@T("Alloué")</label>
                                    <input class="form-control" disabled value="@Money.Format(_budget.Amount)" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="glping-fiche-field">
                                    <label>@T("Imputé")</label>
                                    <input class="form-control" disabled value="@Money.Format(Spent)" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="glping-fiche-field">
                                    <label>@T("Reste")</label>
                                    <input class="form-control @(Remaining < 0 ? "text-danger fw-semibold" : "")"
                                           disabled value="@Money.Format(Remaining)" />
                                </div>
                            </div>
                        </div>
                        break;

                    case "couts":
                        <p class="text-secondary">
                            @T("Coûts de contrat imputés sur ce budget. Ils se saisissent depuis la fiche du contrat concerné, là où ils ont un sens.")
                        </p>

                        @if (_costs.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-coin"></i>
                                <p class="mb-0">@T("Aucun coût imputé sur ce budget.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>@T("Contrat")</th>
                                            <th>@T("Intitulé")</th>
                                            <th>@T("Période")</th>
                                            <th class="text-end">@T("Montant")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ContractCost cost in _costs)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/management/contracts/{cost.ContractId}")" class="text-reset fw-semibold">
                                                        @cost.Contract?.Name
                                                    </a>
                                                </td>
                                                <td class="text-secondary">@cost.Name</td>
                                                <td class="text-secondary">
                                                    @Display.LocalDate(cost.StartDate) — @Display.LocalDate(cost.EndDate)
                                                </td>
                                                <td class="text-end">@Money.Format(cost.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-end">@T("Total imputé")</th>
                                            <th class="text-end">@Money.Format(Spent)</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.Budget" ItemId="BudgetId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.Budget" ItemId="BudgetId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
