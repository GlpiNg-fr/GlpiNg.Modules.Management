@page "/management/budgets"
@rendermode InteractiveServer

<PageTitle>Budgets — GlpiNg</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" class="form-control" placeholder="Rechercher un budget..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;">
                    <p class="mb-2">
                        Supprimer @_selectedIds.Count budget(s) ? Les coûts qui leur étaient imputés
                        restent, sans budget. Cette action est définitive.
                    </p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newBudgetModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input class="form-check-input m-0" type="checkbox" title="Sélectionner les éléments visibles"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>Nom</th>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Période</th>
                    <th class="text-end">Montant alloué</th>
                    <th class="text-end">Imputé</th>
                    <th class="text-end">Reste</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-secondary py-4">Aucun budget.</td></tr>
                }
                else
                {
                    @foreach (Budget budget in _filtered)
                    {
                        decimal spent = _spentByBudget.TryGetValue(budget.Id, out decimal value) ? value : 0m;

                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(budget.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(budget.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/management/budgets/{budget.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-report-money me-1 text-secondary"></i>@budget.Name
                                </a>
                            </td>
                            <td class="text-secondary">@budget.Code</td>
                            <td class="text-secondary">@budget.Type</td>
                            <td class="text-secondary">
                                @budget.StartDate?.ToString("dd/MM/yyyy") — @budget.EndDate?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end">@Money.Format(budget.Amount)</td>
                            <td class="text-end text-secondary">@Money.Format(spent)</td>
                            <td class="text-end">
                                @* Un dépassement se voit tout de suite : c'est la seule raison de tenir un budget. *@
                                <span class="@(budget.Amount - spent < 0 ? "text-danger fw-semibold" : "")">
                                    @Money.Format(budget.Amount - spent)
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newBudgetModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-report-money me-2"></i>Nouvel élément - Budget</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="glpi-fiche-field">
                    <label>Nom<span class="text-danger ms-1" title="Champ obligatoire">*</span></label>
                    <input class="form-control" @bind="_newBudget.Name" @bind:event="oninput" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Code</label>
                    <input class="form-control" @bind="_newBudget.Code" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Type</label>
                    <input class="form-control" placeholder="Investissement, fonctionnement…" @bind="_newBudget.Type" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Montant alloué</label>
                    <input class="form-control" type="number" step="0.01" @bind="_newBudget.Amount" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Début</label>
                    <input class="form-control" type="date" @bind="_newBudget.StartDate" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Fin</label>
                    <input class="form-control" type="date" @bind="_newBudget.EndDate" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newBudget.Name)"
                        @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
